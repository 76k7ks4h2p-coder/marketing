# =============================================================================
# OwnerBase 環境変数サンプル
# -----------------------------------------------------------------------------
# このファイルをコピーして .env.local を作成してください。
#
#   cp .env.example .env.local
#
# .env.local は Git 管理対象外です（.gitignore 済み）。
# Secret Key / service_role キーなどの秘密情報は絶対にここへ書かず、
# また NEXT_PUBLIC_ 接頭辞を付けないでください（ブラウザへ露出します）。
# =============================================================================

# -----------------------------------------------------------------------------
# 必須: Supabase 接続情報
# -----------------------------------------------------------------------------
# Supabase ダッシュボード > Project Settings > Data API から取得します。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase ダッシュボード > Project Settings > API Keys の
# "Publishable key"（旧 anon key）を設定します。
# ブラウザへ配布されるキーです。Secret key / service_role key は使わないでください。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# 任意: メール通知（Resend）
# -----------------------------------------------------------------------------
# 未設定でもアプリは正常に動作します。その場合、通知内容はサーバーログへ出力されます。
# RESEND_API_KEY はサーバー専用の秘密情報です。NEXT_PUBLIC_ を付けないでください。
RESEND_API_KEY=

# 送信元アドレス（Resend で検証済みのドメインのもの）
# 例: OwnerBase <noreply@example.com>
NOTIFICATION_FROM_EMAIL=

# 新規依頼・見積もり選択の通知を受け取る運営管理者のアドレス
ADMIN_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# 任意: サイトの公開 URL
# -----------------------------------------------------------------------------
# 認証メール内のリンク生成などに使用します。未設定の場合はリクエストのオリジンを使用します。
# 例: https://ownerbase.example.com
NEXT_PUBLIC_SITE_URL=
